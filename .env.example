# ============================================================================
# PULSE configuration.  cp .env.example .env   then replace every CHANGE_ME.
# Easiest: ./scripts/gen-secrets.sh creates .env for you with fresh secrets.
# NEVER commit .env. BACK UP FIELD_ENCRYPTION_KEYS: encrypted request text is unreadable without it.
# The production stack refuses to start with placeholders, short secrets, or demo settings.
# ============================================================================

# --- database (used by the db container and to build DATABASE_URL) ---
POSTGRES_USER=pulse
POSTGRES_DB=pulse
POSTGRES_PASSWORD=CHANGE_ME

# --- secrets ---
JWT_SECRET=CHANGE_ME
FIELD_ENCRYPTION_KEYS=CHANGE_ME      # comma separated Fernet keys; first encrypts, all decrypt (key rotation)

# --- web ---
WEB_PORT=8080
COOKIE_SECURE=true                  # keep true: serve over HTTPS (browsers accept it on http://localhost for trials)
COOKIE_SAMESITE=lax
CORS_ORIGINS=                       # empty = same-origin only (recommended)
DOCS_ENABLED=true                   # /api/docs, /api/redoc; set false to hide the interactive docs
WEB_CONCURRENCY=2
LOG_LEVEL=INFO

# --- first administrator (used once by: docker compose run --rm api python -m app.cli bootstrap-admin) ---
BOOTSTRAP_ADMIN_EMAIL=admin@your-college.edu
BOOTSTRAP_ADMIN_PASSWORD=            # leave empty to have a one-time password generated and printed

# --- policy knobs (defaults shown) ---
CAMPUS_TIMEZONE=Asia/Kolkata         # time-of-day buckets in the heatmap
CRISIS_RESOURCES=Emergency: 112 | Tele-MANAS (24x7 mental health support): 14416
AGGREGATE_MIN_CELL=5                 # counts below this are hidden for sensitive categories
BREAK_GLASS_HOURS=48                 # how long student-approved extra access lasts
AUTO_CLOSE_RESOLVED_DAYS=7           # resolved requests with no feedback close after this
CASE_WINDOW_DAYS=21                  # support-case suggestion rule: >= CASE_MIN_REQUESTS in
CASE_MIN_REQUESTS=3                  #   >= CASE_MIN_DEPARTMENTS different departments
CASE_MIN_DEPARTMENTS=3               #   within CASE_WINDOW_DAYS

# Not read by the production compose file (hard-wired off): DEMO_MODE, SERVE_FRONTEND, APP_ENV.
